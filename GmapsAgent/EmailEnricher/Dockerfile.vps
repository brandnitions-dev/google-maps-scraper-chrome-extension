# VPS / Docker image (see GmapsAgent/deploy/vps/docker-compose.yml)
FROM mcr.microsoft.com/playwright/python:v1.49.0-jammy

WORKDIR /app
ENV PYTHONUNBUFFERED=1
ENV PLAYWRIGHT_BROWSERS_PATH=/ms-playwright

COPY . /app
RUN pip install --no-cache-dir -e ".[cloud]"

EXPOSE 18765
CMD ["python", "-m", "uvicorn", "email_enricher.cloud_server:app", "--host", "0.0.0.0", "--port", "18765"]
