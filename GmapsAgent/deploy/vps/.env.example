# Copy to .env on the VPS (never commit .env).
#
# Generate admin password hash (run once locally or in a throwaway container):
#   python -c "import bcrypt; print(bcrypt.hashpw(b'YOUR_PASSWORD', bcrypt.gensalt()).decode())"
#
# JWT_SECRET: long random string (32+ chars)
#
ADMIN_USER=admin
ADMIN_PASSWORD_BCRYPT=
JWT_SECRET=

# Optional: edit docker-compose.yml ports if 31876/31877 are taken on the host.